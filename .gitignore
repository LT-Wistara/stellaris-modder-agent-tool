# Build and run artifacts. `client-config` holds machine-absolute paths and is
# regenerated by `python scripts/configure.py`; `scripts/build_release.py`
# excludes both it and this file's own output.
__pycache__/
*.py[cod]
*.egg-info/
.venv/
build/
dist/
client-config/

# Runtime output from start.py
start-error.log

# Corpus updater staging/backup directories (`stellaris_modder_tool.py update-corpus`)
.staging-corpus-*/
config.previous/

# Generated evaluation output; `python scripts/evaluate_fuzzy.py` rebuilds it and
# nothing in the shipped tool reads it.
docs/FUZZY_EVALUATION.json
